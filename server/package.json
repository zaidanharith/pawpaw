{
  "name": "kidconnect-server",
  "version": "1.0.0",
  "description": "Backend API for KidConnect - Kindergarten Activity Tracking System",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "npx dotenv -e .env -- prisma generate",
    "prisma:push": "npx dotenv -e .env -- prisma db push",
    "prisma:studio": "npx dotenv -e .env -- prisma studio",
    "prisma:seed": "npx dotenv -e .env -- node prisma/seed.js",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "db:reset": "npx dotenv -e .env -- node prisma/reset.js",
    "db:seed": "npx dotenv -e .env -- node prisma/seed.js",
    "db:reset-seed": "npm run db:reset && npm run prisma:push && npm run db:seed",
    "db:fresh": "npm run prisma:generate && npm run db:reset && npm run prisma:push && npm run db:seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "kidconnect",
    "api",
    "express",
    "mongodb",
    "prisma"
  ],
  "author": "Kelompok 13",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^165.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
