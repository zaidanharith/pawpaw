  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaidanharith/pawpaw.git"
  },
  "keywords": [
    "kidconnect",
    "education",
    "school-management",
    "kindergarten",
    "parent-teacher-communication"
  ],
